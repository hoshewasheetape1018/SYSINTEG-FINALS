# Copy this file to backend/.env for local development.
# Never commit a real Jotform API key or production database password.

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8090/'

# Values matching the Docker Compose MySQL service.
database.default.hostname = mysql
database.default.database = app
database.default.username = app
database.default.password = app
database.default.DBDriver = MySQLi
database.default.port = 3306

# Public form used as the catalog source; also the application default.
JOTFORM_FORM_ID = 263211686457058
JOTFORM_API_URL = https://api.jotform.com

# Required only for sending completed website orders to Jotform.
JOTFORM_API_KEY = replace_with_your_jotform_api_key

# Refresh the cached catalog every 15 minutes.
JOTFORM_CATALOG_SYNC_TTL = 900

# Optional JSON override when a copied form uses different question IDs.
# JOTFORM_FIELD_MAP = {"customer_name":"3","email":"4","phone":"5"}
